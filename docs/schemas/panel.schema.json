{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/youngfly93/drug_panel_auto/docs/schemas/panel.schema.json",
  "title": "Panel Package Manifest (panel.yaml)",
  "description": "Contract for a panel package under panels/<panel_id>/panel.yaml. Drives panel discovery, template selection, input/output contracts, QA gates, and golden-case regression.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "panel_id",
    "display_name",
    "version",
    "status",
    "default_template",
    "templates",
    "rules",
    "input_contract",
    "template_contract"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "description": "Manifest schema version. Currently \"1.0\".",
      "enum": ["1.0"]
    },
    "panel_id": {
      "type": "string",
      "description": "Stable identifier, lowercase snake_case. Must match the directory name under panels/.",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "display_name": {
      "type": "string",
      "description": "Human-readable name shown in the web UI and report front matter."
    },
    "version": {
      "type": "string",
      "description": "Panel package semver. Bumped on rule/template changes.",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "status": {
      "type": "string",
      "description": "Lifecycle. draft = engineering-only and not available for delivery; pilot = internal validation only; active = serving customers; deprecated = scheduled for removal.",
      "enum": ["draft", "pilot", "active", "deprecated"]
    },
    "description": {
      "type": "string"
    },
    "aliases": {
      "type": "array",
      "description": "Alternate identifiers (legacy names, shortcodes). Project detector tries these for back-compat.",
      "items": { "type": "string" }
    },
    "project_detector_rules": {
      "type": "object",
      "description": "Heuristics for auto-detecting this panel from Excel filename / sheet content.",
      "additionalProperties": false,
      "properties": {
        "priority": { "type": "number" },
        "identity_family": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "default_project_type", "pdl1"],
          "properties": {
            "id": { "type": "string" },
            "default_project_type": { "type": "string" },
            "pdl1": { "type": "boolean" }
          }
        },
        "structural_fingerprints": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "required_tables"],
            "properties": {
              "id": { "type": "string" },
              "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
              "required_tables": {
                "type": "object",
                "additionalProperties": {
                  "type": "object",
                  "required": ["required_columns"],
                  "additionalProperties": false,
                  "properties": {
                    "required_columns": { "type": "array", "minItems": 1, "items": { "type": "string" } }
                  }
                }
              }
            }
          }
        },
        "keywords": {
          "type": "array",
          "items": { "type": "string" }
        },
        "keyword_groups": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "properties": {
              "any": {
                "type": "array",
                "items": {
                  "oneOf": [
                    { "type": "string" },
                    {
                      "type": "object",
                      "required": ["type", "pattern"],
                      "properties": {
                        "type": { "type": "string", "enum": ["regex"] },
                        "pattern": { "type": "string" }
                      }
                    }
                  ]
                }
              },
              "weight": { "type": "number" }
            }
          }
        }
      }
    },
    "batch_generation": {
      "type": "object",
      "description": "Panel-owned batch availability and per-case clinical-input policy.",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "clinical_info_mode": {
          "type": "string",
          "enum": ["shared", "per_case_required", "case_isolated_optional"]
        },
        "missing_display_defaults": { "type": "object", "additionalProperties": { "type": "string" } },
        "shared_field_exclusions": { "type": "array", "items": { "type": "string" } },
        "reason": { "type": "string" }
      }
    },
    "part3_knowledge": {
      "type": "object",
      "description": "Panel-owned gate for patient-visible Part-3 gene/variant knowledge. Disabled panels render an explicit notice and must not fall back to the shared knowledge base.",
      "additionalProperties": false,
      "required": ["enabled"],
      "properties": {
        "enabled": { "type": "boolean" },
        "release_mode": { "type": "string" },
        "cross_cancer_residual_scan": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "severity": { "type": "string", "enum": ["warn", "fail"] },
            "scan_scope": { "type": "string" },
            "runtime_action": { "type": "string" },
            "suppressed_text": { "type": "string" },
            "terms": { "type": "array", "items": { "type": "string" } },
            "notice": { "type": "string" }
          }
        },
        "reason": { "type": "string" },
        "disabled_notice": { "type": "string", "minLength": 1 }
      }
    },
    "derived_input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["membership_column", "genes", "provenance"],
      "properties": {
        "membership_column": { "type": "string", "pattern": "^ExistInsmall[0-9]+$" },
        "genes": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
        "provenance": { "type": "string" }
      }
    },
    "golden_template_source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256", "family", "builder"],
      "properties": {
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "family": { "type": "string" },
        "builder": { "type": "string" }
      }
    },
    "reviewed_part3_overlay_additions": { "type": "array", "items": { "type": "string" } },
    "review_candidate_contract": { "type": "string" },
    "release_governance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "uat_policy": { "type": "string" },
        "report_group_uat_decisions": { "type": "string" }
      }
    },
    "enhancer": {
      "type": "string",
      "description": "Fully-qualified Python class path of a PanelEnhancer (module:Class). Empty string = no enhancement (NoopEnhancer). Same enhancer can serve multiple panels (e.g. CRC358Enhancer serves both crc_358_msi and crc_301_msi)."
    },
    "default_template": {
      "type": "string",
      "description": "Template id (from the templates list) used when the web form does not override. Must match exactly one templates[].id."
    },
    "templates": {
      "type": "array",
      "minItems": 1,
      "description": "All templates this panel can render. At least one must be active for the default_template to resolve.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "file", "version", "status"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*(_v\\d+)?$" },
          "file": {
            "type": "string",
            "description": "Path relative to the panel directory, typically templates/<id>.docx"
          },
          "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[A-Za-z0-9.-]+)?$" },
          "status": {
            "type": "string",
            "enum": ["draft", "pilot", "active", "deprecated"]
          },
          "description": { "type": "string" },
          "processors": {
            "type": "array",
            "description": "Optional override of the panel-level processors chain for this specific template.",
            "items": { "type": "string" }
          }
        }
      }
    },
    "mappings": {
      "type": "object",
      "description": "Excel→template variable mappings. Paths relative to the repo root (typically config/mapping.yaml).",
      "properties": {
        "default": { "type": "string" }
      }
    },
    "rules": {
      "type": "object",
      "description": "Panel-specific business rule files. Paths relative to the panel directory (rules/*.yaml) or repo root (config/*.yaml).",
      "additionalProperties": { "type": "string" },
      "properties": {
        "panel_rules": { "type": "string" },
        "report_text": { "type": "string" },
        "biomarkers": { "type": "string" },
        "guideline_tables": { "type": "string" },
        "drugs": { "type": "string" },
        "style": { "type": "string" },
        "filtering": { "type": "string" },
        "drug_brands": { "type": "string" }
      }
    },
    "input_contract": {
      "type": "object",
      "description": "What the input Excel must look like for this panel.",
      "additionalProperties": false,
      "required": ["required_tables", "required_single_fields"],
      "properties": {
        "required_tables": {
          "type": "array",
          "items": { "type": "string" }
        },
        "optional_tables": {
          "type": "array",
          "items": { "type": "string" }
        },
        "required_single_fields": {
          "type": "array",
          "items": { "type": "string" }
        },
        "required_columns": {
          "type": "object",
          "description": "Per-table required columns. Keys are sheet names, values are arrays of column names.",
          "additionalProperties": {
            "type": "array",
            "items": { "type": "string" }
          }
        },
        "required_any_columns": {
          "type": "object",
          "description": "Per-table alternative columns. At least one named column must exist.",
          "additionalProperties": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          }
        },
        "biomarkers": {
          "type": "object",
          "description": "Biomarker source declarations (tmb_value / msi_status).",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "required": { "type": "boolean" },
              "minimum": { "type": "number" },
              "maximum": { "type": "number" },
              "source_priority": {
                "type": "array",
                "items": { "type": "string" }
              },
              "missing_values": {
                "type": "array",
                "items": { "type": "string" }
              },
              "allowed_values": {
                "type": "array",
                "items": { "type": "string" }
              },
              "classification_ranges": {
                "type": "object",
                "additionalProperties": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["field"],
                  "properties": {
                    "field": { "type": "string" },
                    "minimum": { "type": "number" },
                    "maximum": { "type": "number" },
                    "minimum_inclusive": { "type": "boolean" },
                    "maximum_inclusive": { "type": "boolean" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "template_contract": {
      "type": "object",
      "description": "What variables/loops the template must reference. Validated at render time.",
      "additionalProperties": false,
      "required": ["required_variables", "required_lists"],
      "properties": {
        "required_variables": {
          "type": "array",
          "description": "Scalar {{ var }} placeholders that must appear in the template.",
          "items": { "type": "string" }
        },
        "required_lists": {
          "type": "array",
          "description": "List names referenced by {%tr for row in <list> %} loops.",
          "items": { "type": "string" }
        },
        "required_markers": {
          "type": "array",
          "description": "Structural markers that must occur exactly once in the selected DOCX template.",
          "items": { "type": "string" }
        },
        "required_table_structures": {
          "type": "object",
          "description": "Per-table column count + required header row.",
          "additionalProperties": {
            "type": "object",
            "required": ["columns", "required_headers"],
            "properties": {
              "columns": { "type": "integer", "minimum": 1 },
              "required_headers": {
                "type": "array",
                "items": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "context_contracts": {
      "type": "object",
      "description": "Named context-contract fixture files (under context_contracts/) used by regression tests.",
      "additionalProperties": { "type": "string" }
    },
    "processors": {
      "type": "array",
      "description": "Default chain of post-render DOCX processors (e.g. blank_page_cleanup, toc_refresh, final_refresh_cleanup). Empty array = no post-processing.",
      "items": { "type": "string" }
    },
    "golden_cases": {
      "type": "array",
      "description": "Reviewed-case fixtures used as regression gates. Each entry runs a command and expects a QA status.",
      "items": {
        "type": "object",
        "required": ["id", "runner", "command", "expected_qa_status"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "runner": { "type": "string" },
          "command": { "type": "string" },
          "synthetic": { "type": "boolean" },
          "expected_qa_status": {
            "type": "string",
            "enum": ["PASS", "WARN", "FAIL"]
          }
        }
      }
    }
  }
}
