# Application settings (prefix: RG_WEB_)
RG_WEB_SECRET_KEY=change-me-in-production
RG_WEB_DEFAULT_ADMIN_USERNAME=admin
RG_WEB_DEFAULT_ADMIN_PASSWORD=admin123
RG_WEB_MAX_WORKERS=4

# Override upstream paths (optional)
# RG_WEB_UPSTREAM_ROOT=/path/to/基因组panel自动化系统
# RG_WEB_STORAGE_ROOT=/path/to/storage

# Optional patient enrichment / operation-system lookup.
# If configured, Excel upload will extract sample_id and query this endpoint to
# fill patient_name/gender/age/clinical_diagnosis/sample fields. Do not commit
# real tokens.
# RG_WEB_PATIENT_ENRICHMENT_PROVIDER=generic
# RG_WEB_PATIENT_ENRICHMENT_URL=https://ops.example.com/api/patients/enrich
# RG_WEB_PATIENT_ENRICHMENT_TOKEN=
# RG_WEB_PATIENT_ENRICHMENT_TIMEOUT_SECONDS=5
# RG_WEB_PATIENT_ENRICHMENT_SOURCE_NAME=operation_system

# MarvelBio operation-system lookup uses AES/CBC/PKCS5Padding POST payloads.
# Keep the AES key and fixed encryptFlag in deployment secrets only.
# RG_WEB_PATIENT_ENRICHMENT_PROVIDER=marvelbio
# RG_WEB_PATIENT_ENRICHMENT_URL=https://webapi.marvelbio.com/ngsapi/getNgsSample
# RG_WEB_PATIENT_ENRICHMENT_AES_KEY=
# RG_WEB_PATIENT_ENRICHMENT_ENCRYPT_FLAG=
